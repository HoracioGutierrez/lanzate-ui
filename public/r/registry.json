{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "mi-registry",
  "homepage": "https://lanzate-ui.vercel.app",
  "items": [
    {
      "name": "lanzate-theme",
      "type": "registry:theme",
      "title": "Lanzate Theme",
      "description": "Design tokens shared by every Lanzate UI component. Generated from tokens/; do not edit by hand.",
      "files": [
        {
          "path": "src/lib/tokens.types.ts",
          "type": "registry:lib"
        }
      ],
      "cssVars": {
        "theme": {
          "color-primary": "var(--primary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-error": "var(--error)",
          "color-error-foreground": "var(--error-foreground)",
          "color-info": "var(--info)",
          "color-info-foreground": "var(--info-foreground)",
          "color-warning": "var(--warning)",
          "color-warning-foreground": "var(--warning-foreground)",
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "text-3xs": "0.625rem",
          "text-2xs": "0.6875rem",
          "text-xs": "clamp(0.75rem, calc(0.708rem + 0.208vw), 0.875rem)",
          "text-sm": "clamp(0.875rem, calc(0.833rem + 0.208vw), 1rem)",
          "text-base": "clamp(1rem, calc(0.958rem + 0.208vw), 1.125rem)",
          "text-lg": "clamp(1.125rem, calc(1.042rem + 0.417vw), 1.375rem)",
          "text-xl": "clamp(1.25rem, calc(1.125rem + 0.625vw), 1.625rem)",
          "text-2xl": "clamp(1.5rem, calc(1.25rem + 1.25vw), 2.25rem)",
          "text-display": "clamp(2rem, calc(1.417rem + 2.917vw), 3.75rem)",
          "shadow-elevated": "0 4px 12px oklch(0 0 0 / 0.15)",
          "shadow-elevated-hover": "0 6px 20px oklch(0 0 0 / 0.2)",
          "shadow-elevated-active": "0 2px 6px oklch(0 0 0 / 0.12)",
          "shadow-button-glow": "0 0 8px 2px color-mix(in oklch, var(--btn-color) 50%, transparent), 0 0 24px 6px color-mix(in oklch, var(--btn-color) 22%, transparent)",
          "shadow-button-glow-hover": "0 0 12px 4px color-mix(in oklch, var(--btn-color) 65%, transparent), 0 0 36px 10px color-mix(in oklch, var(--btn-color) 30%, transparent)",
          "shadow-button-glow-active": "0 0 5px 1px color-mix(in oklch, var(--btn-color) 40%, transparent), 0 0 14px 3px color-mix(in oklch, var(--btn-color) 18%, transparent)",
          "shadow-button-surface": "inset 0 1px 0 oklch(1 0 0 / 0.35), inset 0 -1px 0 oklch(0 0 0 / 0.25), inset 1px 0 0 oklch(1 0 0 / 0.15), inset -1px 0 0 oklch(0 0 0 / 0.12)",
          "shadow-button-surface-active": "inset 0 2px 1px oklch(0 0 0 / 0.15), inset 0 -1px 0 oklch(1 0 0 / 0.08)",
          "ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
          "font-heading": "var(--font-sans)"
        },
        "light": {
          "primary": "oklch(0.62 0.18 35)",
          "primary-foreground": "oklch(0.985 0 0)",
          "error": "oklch(0.577 0.245 27.325)",
          "error-foreground": "oklch(1 0 0)",
          "info": "oklch(0.60 0.15 240)",
          "info-foreground": "oklch(1 0 0)",
          "warning": "oklch(0.70 0.15 85)",
          "warning-foreground": "oklch(0 0 0)",
          "success": "oklch(0.55 0.15 142)",
          "success-foreground": "oklch(1 0 0)",
          "button-surface-gradient": "linear-gradient(to bottom, oklch(1 0 0 / 0.12), oklch(0 0 0 / 0.1))",
          "button-surface-gradient-active": "linear-gradient(to bottom, oklch(0 0 0 / 0.08), oklch(1 0 0 / 0.04))"
        },
        "dark": {
          "primary": "oklch(0.66 0.18 35)",
          "primary-foreground": "oklch(0.98 0.01 80)",
          "error": "oklch(0.704 0.191 22.216)",
          "error-foreground": "oklch(1 0 0)",
          "info": "oklch(0.70 0.15 240)",
          "info-foreground": "oklch(1 0 0)",
          "warning": "oklch(0.75 0.14 85)",
          "warning-foreground": "oklch(0 0 0)",
          "success": "oklch(0.65 0.14 142)",
          "success-foreground": "oklch(1 0 0)"
        }
      }
    },
